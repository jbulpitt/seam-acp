# --- Discord ---
DISCORD_BOT_TOKEN=
# Comma-separated list of Discord user IDs allowed to control the bot.
# Single user: DISCORD_ALLOWED_USER_IDS=123456789
# Multiple users: DISCORD_ALLOWED_USER_IDS=123456789,987654321
DISCORD_ALLOWED_USER_IDS=
# Optional: register slash commands instantly to a single guild for development.
DISCORD_DEV_GUILD_ID=

# Speaker identity (issue #57), default off. When true, each human turn stamps
# the speaker's name + Discord id into the harness preamble so the agent can
# attribute turns across a multi-person thread. NOTE: enabling sends real human
# names (including minors') to the model provider on every turn — a conscious
# choice, which is why it defaults off. Rollback is the flag: set false + redeploy.
SPEAKER_IDENTITY_ENABLED=false
# Optional override map of Discord user id -> display name, "<id>:Name,<id>:Name".
# Takes precedence over the Discord nickname/global-name/username. Mapping all
# family ids here also moves the displayed name from user control to admin
# control (a nickname change no longer alters what the model sees). Example:
# DISCORD_USER_NAMES=1487094572696867019:Jesse,1490000000000000000:Jennifer,1534937951044112505:Allie
DISCORD_USER_NAMES=

# --- Storage / sandbox ---
# Root folder containing repos the agent is allowed to work in.
REPOS_ROOT=/Users/you/Projects
# Comma-separated extra absolute directories that `/seam attach` and the
# fence-as-file shortcut may read from. REPOS_ROOT is always allowed.
# ATTACH_ROOTS=/Users/you/Downloads,/Users/you/Documents
# Where to store sqlite + per-session data.
DATA_DIR=./data

# --- Agent ---
# Which agent profile to use by default. Currently: "copilot".
DEFAULT_AGENT=copilot
# Default model id (e.g. gpt-5.4, claude-sonnet-4.5, claude-opus-4.7, auto).
DEFAULT_MODEL=gpt-5.4
# Optional explicit path to the copilot CLI; defaults to "copilot" on PATH.
COPILOT_CLI_PATH=
# Register additional Copilot profiles, each with its own --config-dir
# (= its own auth, MCP config, session history). Format:
#   id1:/abs/path/to/dir1,id2:/abs/path/to/dir2
# Each becomes an agent profile named `copilot-<id>` selectable in
# /seam agent. Run `COPILOT_HOME=<dir> copilot login` once per profile.
# COPILOT_PROFILES=work:/Users/you/.copilot-work,personal:/Users/you/.copilot-personal
# Optional explicit path to the gemini CLI; defaults to "gemini" on PATH.
GEMINI_CLI_PATH=
# Default model for the Gemini profile (overrides DEFAULT_MODEL when
# DEFAULT_AGENT=gemini or when a session picks gemini).
GEMINI_DEFAULT_MODEL=gemini-2.5-pro
# Register additional Gemini profiles, each with its own GEMINI_CLI_HOME
# (= a fake home dir; Gemini stores all state under <dir>/.gemini/).
# Format mirrors COPILOT_PROFILES:
#   id1:/abs/path/to/dir1,id2:/abs/path/to/dir2
# Each becomes an agent profile named `gemini-<id>` selectable in /seam agent.
# Run `GEMINI_CLI_HOME=<dir> gemini /auth` once per profile.
# GEMINI_PROFILES=work:/Users/you/gemini-work,personal:/Users/you/gemini-personal

# --- Anthropic Claude (optional) ---
# Install the adapter: npm i -g @anthropic-ai/claude-code @agentclientprotocol/claude-agent-acp
# Then: claude /login
# Optional explicit path to claude-agent-acp; defaults to "claude-agent-acp" on PATH.
CLAUDE_CLI_PATH=
# Default model for the Claude profile. `default` auto-rolls to the latest Opus
# (1M context) on Max/Team-Premium accounts.
CLAUDE_DEFAULT_MODEL=default
# Model picker (comma-separated `id:label`). Full canonical IDs resolve to
# themselves as of claude-agent-acp ≥0.42 — no `[1m]` suffix or local patch.
# Native context windows are declared in src/agents/profiles/claude.ts.
CLAUDE_MODELS=default:Opus latest • 1M 🪟 ⭐,claude-opus-5:Opus 5 • 1M 🪟,claude-opus-4-8:Opus 4.8 • 1M 🪟,claude-opus-4-7:Opus 4.7 • 1M 🪟,claude-opus-4-6:Opus 4.6 • 200K 🪟,claude-fable-5:Fable 5 • 1M 🪟,claude-sonnet-5:Sonnet 5 • 1M 🪟,claude-sonnet-4-6:Sonnet 4.6 • 200K 🪟,claude-haiku-4-5:Haiku 4.5 • 200K 🪟
# Register additional Claude profiles, each with its own CLAUDE_CONFIG_DIR
# (= its own auth + settings). Format mirrors COPILOT_PROFILES:
#   id1:/abs/path/to/dir1,id2:/abs/path/to/dir2
# Each becomes an agent profile named `claude-<id>` selectable in /seam agent.
# Run `CLAUDE_CONFIG_DIR=<dir> claude /login` once per profile.
# CLAUDE_PROFILES=work:/Users/you/.claude-work,personal:/Users/you/.claude-personal

# --- Behavior ---
TURN_TIMEOUT_SECONDS=900
LOG_LEVEL=info
HEALTH_PORT=3000
# Bot-wide default permission policy for new sessions.
# - always: auto-approve every request (yolo)
# - ask:    post a Discord prompt with buttons; deny on 5-min timeout (recommended)
# - deny:   auto-deny everything
# Override per-session with /seam approve <always|ask|deny>.
DEFAULT_PERMISSION_POLICY=ask
# Deprecated. When true, forces the bot-wide default to "always".
DEFAULT_AUTO_APPROVE=false
# Controls the /seam new and /seam init thread initialization flow.
# - repo: (default) only show the repo picker
# - full: after repo selection, also present agent and model pickers
#         in sequence so the user can configure before chatting
# NEW_THREAD_WIZARD=full
# How dispatched-turn output (handoffs, forwards, wakes, watches, chain hops,
# compaction) and report-back callbacks render in the target thread.
# - messages: (default) traditional plain assistant messages, streamed live —
#             just like talking to the bot directly. Overflow spills to a file.
# - card:     legacy blue "📨 Dispatch" embed cards / streamed embed panel.
# SEAM_DISPATCH_OUTPUT_STYLE=card
# Give dispatched turns the SAME traditional live status panel that normal user
# turns get — thinking, context-window health, elapsed, model, tool calls — with
# the dispatch TYPE in the panel title (e.g. "📨 Handoff", "⏰ Wake"). Default ON.
# Orthogonal to SEAM_DISPATCH_OUTPUT_STYLE (which controls the answer rendering).
# When on, the panel supersedes the slim "▶" start indicator; set false to
# restore the "▶" indicator and post no panel.
# SEAM_DISPATCH_STATUS_PANEL=false
# Optional path to a JSON file that locks down specific channels/threads
# (e.g. a kid's channel bound to one repo/agent, with slash commands
# disabled). See CHANNEL_PRESETS_FILE in src/config.ts for the full shape;
# example:
#   {
#     "channels": {
#       "<parentChannelId>": {
#         "agent": { "value": "claude" },
#         "model": { "value": "claude-sonnet-4-5" },
#         "cwd": { "value": "/Users/you/Projects/school-app" },
#         "effort": { "value": "medium" },
#         "rider": { "value": "You are talking with Kid1. Only answer questions about Kid1's own work; never reference the other child's data." },
#         "locked": true
#       }
#     },
#     "threads": {
#       "<threadId>": {
#         "rider": { "value": "This is the reading-log thread — only touch reading-log entries." }
#       }
#     }
#   }
# CHANNEL_PRESETS_FILE=./data/channel-presets.json

# --- MCP servers (global, applied to every session) ---
# Playwright: gives the agent a real Chromium browser. Useful for
# screenshots and web tasks; emitted images flow back as Discord
# attachments via the agent-file pipeline.
# Requires Chromium (~150 MB), auto-downloaded by Playwright on first run.
MCP_PLAYWRIGHT_ENABLED=false

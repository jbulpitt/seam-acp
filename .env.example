# --- Discord ---
DISCORD_BOT_TOKEN=
# Comma-separated list of Discord user IDs allowed to control the bot.
# Single user: DISCORD_ALLOWED_USER_IDS=123456789
# Multiple users: DISCORD_ALLOWED_USER_IDS=123456789,987654321
DISCORD_ALLOWED_USER_IDS=
# Optional: register slash commands instantly to a single guild for development.
DISCORD_DEV_GUILD_ID=
# Optional: thread/channel id for a single editable server-status card
# (uptime, turns, connected bridges). Edited in place; no new messages.
# DISCORD_STATUS_THREAD_ID=123456789012345678
# DISCORD_AGENT_QUOTA_THREAD_ID=123456789012345678

# Speaker identity (issue #57), default off. When true, each human turn stamps
# the speaker's name + Discord id into the harness preamble so the agent can
# attribute turns across a multi-person thread. NOTE: enabling sends real human
# names (including minors') to the model provider on every turn — a conscious
# choice, which is why it defaults off. Rollback is the flag: set false + redeploy.
SPEAKER_IDENTITY_ENABLED=false
# Inbox-awareness preamble (#61), default off. When true, each human turn's
# harness includes a standing bullet that a pull-only inbox exists and the
# agent should call `poll_inbox` to drain it (steer / send notes are NOT in
# the prompt). Dispatch / scheduled / wake turns still skip the harness.
SEAM_INBOX_PREAMBLE_ENABLED=false
# Config-mutation admins (#71): may propose/apply in LOCKED channels without unlocking; only ids allowed to click Apply. Comma-separated numeric Discord ids. Does NOT permit changing `locked`.
SEAM_CONFIG_ADMIN_USER_IDS=
# Participants (#74): may chat with agents but never configure anything.
# Must also appear in DISCORD_ALLOWED_USER_IDS. admin > participant > operator.
SEAM_PARTICIPANT_USER_IDS=
# Optional override map of Discord user id -> display name, "<id>:Name,<id>:Name".
# Takes precedence over the Discord nickname/global-name/username. Mapping all
# family ids here also moves the displayed name from user control to admin
# control (a nickname change no longer alters what the model sees). Example:
# DISCORD_USER_NAMES=1487094572696867019:Jesse,1490000000000000000:Jennifer,1534937951044112505:Allie
DISCORD_USER_NAMES=

# Simple status-card GIF catalog (HTTPS JSON `{ version, gifs: [url, ...] }`).
# Fetched at boot and every ~10 minutes with a browser User-Agent (r2.dev is
# behind Cloudflare bot protection). Empty/failed catalog = no thumbnail.
# SIMPLE_CARD_GIF_MANIFEST_URL=https://pub-d6ab0677dbbb4895a9db45bc6ba2ad08.r2.dev/manifest.json

# --- Storage / sandbox ---
# Root folder containing repos the agent is allowed to work in.
REPOS_ROOT=/Users/you/Projects
# Comma-separated extra absolute directories that `/seam attach` and the
# fence-as-file shortcut may read from. REPOS_ROOT is always allowed.
# ATTACH_ROOTS=/Users/you/Downloads,/Users/you/Documents
# Where to store sqlite + per-session data.
DATA_DIR=./data
# Permanent public WebSocket URL for `/seam bridge add` (named Cloudflare
# tunnel, survives reboot). When set, this wins over data/tunnel-url.txt
# (the quick-tunnel file, which changes every start). Example:
# SEAM_BRIDGE_PUBLIC_URL=wss://seamacp.example.com/bridge
# Public origin for minted POST /ingest URLs (create_ingest). Pages hubs
# should use this host, not the bridge hostname. Unset ⇒ derive from the
# bridge/tunnel/loopback URL (local/dev). Trailing slash is stripped.
# SEAM_INGEST_PUBLIC_URL=https://ingest.example.com

# --- Agent ---
# Which agent profile to use by default. Currently: "copilot".
DEFAULT_AGENT=copilot
# Default model id (e.g. gpt-5.4, claude-sonnet-4.5, claude-opus-4.7, auto).
DEFAULT_MODEL=gpt-5.4
# Optional explicit path to the copilot CLI; defaults to "copilot" on PATH.
COPILOT_CLI_PATH=
# Artificial Analysis key for the 12-hour model-value snapshot refresh.
AA_API_KEY=
# Fixed token split used for cost-per-standard-task comparisons.
MODEL_VALUE_STD_INPUT_TOKENS=8000
MODEL_VALUE_STD_OUTPUT_TOKENS=2000
# Copilot picker overlay (`id:label`). When set, this REPLACES the ACP advertised
# list (it does not merge). Omit to use whatever `copilot --acp` advertises.
# IDs below were the Copilot CLI 1.0.80 ACP session/new list (probed 2026-08-22).
# Includes: gemini-3.7-flash (#55), grok-4.6 (#54), mai-code-1.1-flash (#53),
# kimi-k3 (#49), gpt-5.6-{sol,terra,luna} (#33; no bare gpt-5.6), claude-opus-4.8-fast (#9).
# grok-4.5 (#46) is NOT advertised on this CLI — do not add it.
COPILOT_MODELS=auto:Auto,claude-sonnet-5:Claude Sonnet 5,claude-opus-5:Claude Opus 5,claude-opus-4.8:Claude Opus 4.8,claude-opus-4.8-fast:Claude Opus 4.8 Fast,claude-opus-4.7:Claude Opus 4.7,claude-sonnet-4.6:Claude Sonnet 4.6,claude-opus-4.6:Claude Opus 4.6,claude-sonnet-4.5:Claude Sonnet 4.5,claude-opus-4.5:Claude Opus 4.5,claude-haiku-4.5:Claude Haiku 4.5,gpt-5.6-sol:GPT-5.6 Sol,gpt-5.6-terra:GPT-5.6 Terra,gpt-5.6-luna:GPT-5.6 Luna,gpt-5.5:GPT-5.5,gpt-5.4:GPT-5.4,gpt-5.4-mini:GPT-5.4 mini,gpt-5.3-codex:GPT-5.3-Codex,gpt-5-mini:GPT-5 mini,mai-code-1-flash-picker:MAI-Code-1-Flash,gemini-3.7-flash:Gemini 3.7 Flash,gemini-3.6-flash:Gemini 3.6 Flash,gemini-3.5-flash:Gemini 3.5 Flash,gemini-3.1-pro-preview:Gemini 3.1 Pro,kimi-k3:Kimi K3,grok-4.6:Grok 4.6,mai-code-1.1-flash:MAI-Code-1.1-Flash
# Register additional Copilot profiles, each with its own --config-dir
# (= its own auth, MCP config, session history). Format:
#   id1:/abs/path/to/dir1,id2:/abs/path/to/dir2
# Each becomes an agent profile named `copilot-<id>` selectable in
# /seam config agent. Run `COPILOT_HOME=<dir> copilot login` once per profile.
# COPILOT_PROFILES=work:/Users/you/.copilot-work,personal:/Users/you/.copilot-personal
# Optional explicit path to the gemini CLI; defaults to "gemini" on PATH.
GEMINI_CLI_PATH=
# Default model for the Gemini profile (overrides DEFAULT_MODEL when
# DEFAULT_AGENT=gemini or when a session picks gemini).
GEMINI_DEFAULT_MODEL=gemini-2.5-pro
# Register additional Gemini profiles, each with its own GEMINI_CLI_HOME
# (= a fake home dir; Gemini stores all state under <dir>/.gemini/).
# Format mirrors COPILOT_PROFILES:
#   id1:/abs/path/to/dir1,id2:/abs/path/to/dir2
# Each becomes an agent profile named `gemini-<id>` selectable in /seam config agent.
# Run `GEMINI_CLI_HOME=<dir> gemini /auth` once per profile.
# GEMINI_PROFILES=work:/Users/you/gemini-work,personal:/Users/you/gemini-personal

# --- Anthropic Claude (optional) ---
# Install the adapter: npm i -g @anthropic-ai/claude-code @agentclientprotocol/claude-agent-acp
# Then: claude /login
# Optional explicit path to claude-agent-acp; defaults to "claude-agent-acp" on PATH.
CLAUDE_CLI_PATH=
# Default model for the Claude profile. `default` auto-rolls to the latest Opus
# (1M context) on Max/Team-Premium accounts.
CLAUDE_DEFAULT_MODEL=default
# Model picker (comma-separated `id:label`). Native-1M models only. Full canonical
# IDs resolve to themselves as of claude-agent-acp ≥0.42; no context variants or patch.
# Native context windows are declared in packages/adapters/src/profiles/claude.ts.
CLAUDE_MODELS=default:Opus latest ⭐,claude-fable-5-1:Fable 5.1,claude-opus-5:Opus 5,claude-opus-4-8:Opus 4.8,claude-opus-4-7:Opus 4.7,claude-fable-5:Fable 5,claude-sonnet-5:Sonnet 5
# Register additional Claude profiles, each with its own CLAUDE_CONFIG_DIR
# (= its own auth + settings). Format mirrors COPILOT_PROFILES:
#   id1:/abs/path/to/dir1,id2:/abs/path/to/dir2
# Each becomes an agent profile named `claude-<id>` selectable in /seam config agent.
# Run `CLAUDE_CONFIG_DIR=<dir> claude /login` once per profile.
# CLAUDE_PROFILES=work:/Users/you/.claude-work,personal:/Users/you/.claude-personal

# --- Behavior ---
TURN_TIMEOUT_SECONDS=900
# Bound graceful redeploy drain; expiry force-restarts and relies on turn-resume.
RESTART_DRAIN_TIMEOUT_MS=900000
# Retire warm idle agent process trees while preserving resumable sessions.
# 0 disables. Default 7200 (2 hours).
RUNTIME_IDLE_TTL_SECONDS=7200
LOG_LEVEL=info
HEALTH_PORT=3000
# Google AI Studio key for inbound Discord STT and outbound TTS (control plane).
# Empty = skip transcription / skip speaking.
# SEAM_GEMINI_API_KEY=
# Speech only: developer uses the key above; vertex uses ADC + project.
# SEAM_GEMINI_SPEECH_PROVIDER=developer
# SEAM_GEMINI_VERTEX_PROJECT_ID=
# SEAM_GEMINI_VERTEX_LOCATION=global
# SEAM_GEMINI_STT_MODEL=gemini-3.5-transcribe
# SEAM_GEMINI_VERTEX_STT_MODEL=gemini-3.5-transcribe-preview
# SEAM_GEMINI_VERTEX_LIVE_STT_MODEL=gemini-3.5-transcribe-live-preview
# Smart-transcription vocabulary (comma-separated, normalized and capped at 100).
# SEAM_GEMINI_STT_CUSTOM_VOCABULARY=Seam,seam-acp,Discord,Gemini,Codex,Claude,Grok,Ollama
# SEAM_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# SEAM_GEMINI_TTS_VOICE=Kore
# POST /ingest holds this many ms for submit_result, then 202 + poll.
# Default 300000 (5 min). Ceiling 1800000 (30 min). Cloudflare kills proxied
# POSTs around 100s — microsites should GET /ingest/jobs/:id (or POST ?wait=0).
# SEAM_INGEST_WAIT_MS=300000
# Bot-wide default permission policy for new sessions.
# - always: auto-approve every request (yolo)
# - ask:    post a Discord prompt with buttons; deny on 5-min timeout (recommended)
# - deny:   auto-deny everything
# Override per-session with /seam config approve <always|ask|deny>.
DEFAULT_PERMISSION_POLICY=ask
# Deprecated. When true, forces the bot-wide default to "always".
DEFAULT_AUTO_APPROVE=false
# NEW_THREAD_WIZARD was removed (#157): /seam new and /seam config init both
# post the /seam config edit card now — there is no setup wizard to select.
# How dispatched-turn output (handoffs, forwards, wakes, watches, chain hops,
# compaction) and report-back callbacks render in the target thread.
# - messages: (default) traditional plain assistant messages, streamed live —
#             just like talking to the bot directly. Overflow spills to a file.
# - card:     legacy blue "📨 Dispatch" embed cards / streamed embed panel.
# SEAM_DISPATCH_OUTPUT_STYLE=card
# Give dispatched turns the SAME traditional live status panel that normal user
# turns get — thinking, context-window health, elapsed, model, tool calls — with
# the dispatch TYPE in the panel title (e.g. "📨 Handoff", "⏰ Wake"). Default ON.
# Orthogonal to SEAM_DISPATCH_OUTPUT_STYLE (which controls the answer rendering).
# When on, the panel supersedes the slim "▶" start indicator; set false to
# restore the "▶" indicator and post no panel.
# SEAM_DISPATCH_STATUS_PANEL=false
# Auto-resume interrupted turns after a restart (#76): inject "continue"
# into the SAME ACP session (never replay the original prompt). Default OFF
# — unconfigured == today's behavior. Markers are still written and
# reconciled with the flag off (so /seam workflows can list them); only the
# auto-resume fire is gated. Operator seeds this later.
# SEAM_TURN_RESUME_ENABLED=false
# Max age (seconds) of an interrupted turn that auto-resume will re-fire.
# Past this the turn is abandoned with a notice. Default 7200 (2h).
# SEAM_TURN_RESUME_MAX_AGE_SECONDS=7200
# Optional path to a JSON file that locks down specific channels/threads
# (e.g. a kid's channel bound to one repo/agent, with slash commands
# disabled). See CHANNEL_PRESETS_FILE in src/config.ts for the full shape;
# example:
#   {
#     "channels": {
#       "<parentChannelId>": {
#         "agent": { "value": "claude" },
#         "model": { "value": "claude-sonnet-4-5" },
#         "cwd": { "value": "/Users/you/Projects/school-app" },
#         "effort": { "value": "medium" },
#         "rider": { "value": "You are talking with Kid1. Only answer questions about Kid1's own work; never reference the other child's data." },
#         "locked": true
#       }
#     },
#     "threads": {
#       "<threadId>": {
#         "rider": { "value": "This is the reading-log thread — only touch reading-log entries." }
#       }
#     }
#   }
# CHANNEL_PRESETS_FILE=./data/channel-presets.json

# --- MCP servers (global, applied to every session) ---
# Playwright: globally advertises the host's one shared loopback MCP service.
# The service maintains an isolated browser context for each MCP client.
MCP_PLAYWRIGHT_ENABLED=false
MCP_PLAYWRIGHT_URL=http://localhost:8766/mcp

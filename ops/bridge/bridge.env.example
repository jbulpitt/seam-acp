# ~/.config/seam/bridge.env — mode 0600. The bridge reads this file itself at
# startup; keys here replace the same keys from the supervisor. Its first log
# line names the file and the keys it set.

# Connection (required)
SEAM_BRIDGE_SERVER=wss://bridge.example.com/bridge
SEAM_BRIDGE_ID=<host-id from docs/local/bridge-targets.json>
SEAM_BRIDGE_TOKEN=<bridge token>
SEAM_BRIDGE_CWD=<workspace root, the private target map's workspaceArg>

# Agent CLIs resolve from PATH (unpinned agy included).
PATH=<home>/.nvm/versions/node/v22.22.2/bin:<home>/.local/bin:/usr/local/bin:/usr/bin:/bin

# Agents: set only what this host serves.
AGY_ENABLED=true
AGY_PIN=unpinned
AGY_DEFAULT_MODEL=gemini-3.8-flash-high
AGY_CREDENTIAL_SCOPE=antigravity-oauth:primary

# Optional separate Claude-on-Vertex profile (all configuration belongs here).
# CLAUDE_VERTEX_AGENT_ID=claude-vertex
# CLAUDE_VERTEX_DISPLAY_NAME="Claude (Vertex AI)"
# CLAUDE_VERTEX_PROJECT_ID=your-gcp-project
# CLAUDE_VERTEX_REGION=global
# CLAUDE_VERTEX_CREDENTIALS_FILE=/absolute/path/to/service-account.json
# CLAUDE_VERTEX_CONFIG_DIR=/absolute/path/to/separate-claude-config
# CLAUDE_VERTEX_MODELS=claude-opus-5-5:Opus 5.5,claude-sonnet-5-5:Sonnet 5.5,claude-haiku-5-5:Haiku 5.5
# CLAUDE_VERTEX_DEFAULT_MODEL=claude-sonnet-5-5

# Secrets referenced by project .mcp.json files (the bridge skips a server whose
# variables are unset and logs "unresolved environment variables").

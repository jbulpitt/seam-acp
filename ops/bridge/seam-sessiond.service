# /etc/systemd/system/seam-sessiond.service — replace <user> and <home>.
# Its own unit so agent children survive a bridge restart (#598).
[Unit]
Description=Seam durable agent process supervisor
After=local-fs.target

[Service]
Type=simple
User=<user>
Group=<user>
Environment=HOME=<home>
ExecStart=<home>/.local/libexec/seam-sessiond-launch.sh
Restart=always
RestartSec=2s
# Stop only sessiond; slots keep running under their holders (#631).
KillMode=process
OOMPolicy=continue

[Install]
WantedBy=multi-user.target

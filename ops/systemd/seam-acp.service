[Unit]
Description=Seam ACP Discord bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Projects/seam-acp
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
Environment=PATH=/home/ubuntu/.nvm/versions/node/v22.22.2/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/.nvm/versions/node/v22.22.2/bin/node packages/core/dist/index.js
Restart=always
RestartSec=5s
TimeoutStopSec=120s
KillSignal=SIGTERM
KillMode=control-group
OOMPolicy=continue
LimitNOFILE=65535
SyslogIdentifier=seam-acp

[Install]
WantedBy=multi-user.target

[Unit]
Description=Seam ACP Discord bot
Wants=network-online.target seam-local-bridge.service
After=network-online.target seam-local-bridge.service
StartLimitIntervalSec=300
StartLimitBurst=6

[Service]
Type=simple
User=seam
Group=seam
WorkingDirectory=/opt/seam-acp
Environment=HOME=/var/lib/seam
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/seam/seam-acp.env
ExecStart=/usr/bin/env node packages/core/dist/index.js
Restart=always
RestartSec=5s
TimeoutStopSec=120s
KillSignal=SIGTERM
KillMode=mixed
FinalKillSignal=SIGKILL
SendSIGKILL=yes
OOMPolicy=continue
LimitNOFILE=65535
SyslogIdentifier=seam-acp

[Install]
WantedBy=multi-user.target

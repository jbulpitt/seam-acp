[Unit]
Description=Seam scheduled CLI release and drift report
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=seam
Group=seam
WorkingDirectory=/opt/seam-acp
Environment=HOME=/var/lib/seam
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/seam/seam-acp.env
ExecStart=/usr/bin/env node scripts/cli-health-report.mjs
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
UMask=0077
SyslogIdentifier=seam-cli-health-report

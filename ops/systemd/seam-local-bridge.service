[Unit]
Description=Seam bridge for the controller host
Wants=network-online.target
After=network-online.target seam-sessiond.service
Requires=seam-sessiond.service

[Service]
Type=simple
User=seam
Group=seam
WorkingDirectory=/opt/seam-acp
Environment=HOME=/var/lib/seam
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DATA_DIR=/var/lib/seam/data
Environment=REPOS_ROOT=/srv/repos
Environment=HEALTH_PORT=3000
Environment=SEAM_SESSIOND_SOCKET=/run/seam-sessiond/control.sock
Environment=SEAM_SESSIOND_STATE=/run/seam-sessiond/slots.json
EnvironmentFile=-/etc/seam/seam-acp.env
RuntimeDirectory=seam-local-bridge
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/env node packages/bridge/dist/index.js connect --server ws://127.0.0.1:${HEALTH_PORT}/bridge --id local --token-file ${DATA_DIR}/local-bridge/token --cwd ${REPOS_ROOT} --singleton-socket /run/seam-local-bridge/bridge.sock
Restart=always
RestartSec=2s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30s
FinalKillSignal=SIGKILL
SendSIGKILL=yes
OOMPolicy=continue
LimitNOFILE=65535
SyslogIdentifier=seam-local-bridge

[Install]
WantedBy=multi-user.target

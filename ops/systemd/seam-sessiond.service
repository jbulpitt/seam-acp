[Unit]
Description=Seam durable local agent process supervisor
After=local-fs.target

[Service]
Type=simple
User=seam
Group=seam
WorkingDirectory=/opt/seam-acp
Environment=HOME=/var/lib/seam
Environment=PATH=/usr/local/bin:/usr/bin:/bin
RuntimeDirectory=seam-sessiond
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/env node packages/bridge/dist/sessiond.js --socket /run/seam-sessiond/control.sock --state /run/seam-sessiond/slots.json
Restart=always
RestartSec=2s
KillSignal=SIGTERM
KillMode=process
TimeoutStopSec=30s
FinalKillSignal=SIGKILL
SendSIGKILL=yes
OOMPolicy=continue
LimitNOFILE=65535
SyslogIdentifier=seam-sessiond

[Install]
WantedBy=multi-user.target
